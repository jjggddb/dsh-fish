{
  "name": "dsh-fish",
  "version": "0.9.0",
  "description": "基于 dsh-fish 的微信群二开：经历驱动人格、分群记忆、旁听与自主参与",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.5": "unknown"
      },
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "memory"
  ],
  "author": "ssamurias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjggddb/dsh-fish.git"
  },
  "homepage": "https://github.com/jjggddb/dsh-fish/tree/wechat-deployment#readme",
  "bugs": {
    "url": "https://github.com/jjggddb/dsh-fish/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {},
  "contributors": [
    "jjggddb"
  ]
}
